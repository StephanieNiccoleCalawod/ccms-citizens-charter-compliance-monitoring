# ccms-oversight-service (Logs) — copy to .env.local.
# Own database: ccms_oversight. Two connections on purpose (Sprint 4 TT2):
#   DATABASE_URL        what the running service uses: the role ccms_logs_writer (INSERT and SELECT on audit_log only).
#   DATABASE_ADMIN_URL  the schema owner, used only by `npm run db:sync` to create the table, the roles and the grants.
# The running service never synchronises the schema (DB_SYNCHRONIZE=false), so it cannot change or delete an audit row.
DATABASE_URL=postgres://ccms_logs_writer:ccms_logs_writer_dev_pw@127.0.0.1:5437/ccms_oversight
DB_SYNCHRONIZE=false
# local | hosted. hosted refuses db:sync / schema synchronization and requires --confirm=<database> for migrations.
# Hosted deployments (Vercel, BE Dev 1's migration shell) must set DB_TARGET=hosted and DB_SYNCHRONIZE=false.
DB_TARGET=local
DATABASE_ADMIN_URL=postgres://ccms_oversight:ccms_oversight_dev_pw@127.0.0.1:5437/ccms_oversight

# Passwords `npm run db:sync` gives the two roles (ccms_logs_writer, and ccms_oversight_app for the future reports).
# Leave one empty to create its role without a login.
LOGS_WRITER_PASSWORD=ccms_logs_writer_dev_pw
OVERSIGHT_APP_PASSWORD=ccms_oversight_app_dev_pw

# Token verification (Identity publishes the public keys)
IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
JWT_ISSUER=ccms-identity
JWT_AUDIENCE=ccms

# Shared service key: the other services present it when they deliver audit events to POST /api/audit-events and analytics
# events to POST /api/analytics-events (TT2); Oversight presents it to the Operations analytics export.
SERVICE_KEY=change-me-dev-service-key

# TT2 backfill: Operations address, with or without the trailing /api.
OPERATIONS_SERVICE_URL=http://127.0.0.1:3004/api

# CC032 complaints: Core (office check, with SERVICE_KEY) and the mailer for the reference email (same names as Operations/Identity).
CORE_URL=http://127.0.0.1:3003
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Optional: complaints filed per client address per window (default 5 per 3600 s).
# COMPLAINT_RATE_LIMIT=5
# COMPLAINT_RATE_WINDOW_SECONDS=3600

# Job callers send this as "Authorization: Bearer <CRON_SECRET>" to /api/jobs/analytics-backfill. Without it the job never runs.
CRON_SECRET=change-me-dev-cron-secret


# Sprint 6 TT1: allows POST /api/internal/analytics-purge (removes SEEDED rows only). Set to "enabled" on the demo only.
ANALYTICS_SEED_PURGE=

# CC056 staff permission switches: Identity's internal route (read with SERVICE_KEY, kept up to 10 seconds, unreachable = off).
# No Oversight route uses a switch yet; the staff report and complaint views are Sprint 7.
IDENTITY_URL=http://127.0.0.1:3001
