{
  "name": "ccms-oversight-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "ccms": {
    "service": "oversight",
    "port": 3002
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.js run",
    "migrate:run": "node --env-file-if-exists=.env.local scripts/migrate.js run",
    "migrate:revert": "node --env-file-if-exists=.env.local scripts/migrate.js revert",
    "migrate:show": "node --env-file-if-exists=.env.local scripts/migrate.js show",
    "migrate:check-baseline": "node --env-file-if-exists=.env.local scripts/migrate.js check-baseline",
    "migrate:baseline": "node --env-file-if-exists=.env.local scripts/migrate.js baseline",
    "migrate:sprint4": "node --env-file-if-exists=.env.local scripts/migrate-sprint4-critical.js",
    "analytics:backfill": "node --env-file-if-exists=.env.local scripts/analytics-backfill.js",
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "check:time": "ccms-check-time src scripts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "db:sync": "node --env-file-if-exists=.env.local scripts/sync-db.js",
    "ci": "npm run lint && npm run check:time && npm test && npm run build"
  },
  "dependencies": {
    "ccms-shared": "0.1.0",
    "jose": "6.2.12",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5"
  }
}
