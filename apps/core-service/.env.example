# ccms-core-service (Catalogue + Calendar) — copy to .env.local.
# Run db:sync explicitly on a disposable local database before first use.
DATABASE_URL=postgres://ccms_core:ccms_core_dev_pw@127.0.0.1:5435/ccms_core
DB_SYNCHRONIZE=false

# Required only by explicit `npm run db:bootstrap` so recode and seed audit events identify the
# responsible administrator. Use the account_id UUID of an active Super Admin from Identity.
CCMS_SEED_ACTOR_ID=

# Token verification (Identity publishes the public keys)
IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
JWT_ISSUER=ccms-identity
JWT_AUDIENCE=ccms

# Service-to-service shared key and the Logs service (audit events)
SERVICE_KEY=change-me-dev-service-key
LOGS_SERVICE_URL=http://127.0.0.1:3002/api

# Job callers send this as "Authorization: Bearer <CRON_SECRET>" to /api/jobs/*. Without it the jobs never run.
CRON_SECRET=change-me-dev-cron-secret

# Public rate limit (requests per window, per client address). The counter lives in the rate_limit_hits table.
PUBLIC_RATE_LIMIT=60
PUBLIC_RATE_WINDOW_SECONDS=60

# ---- Calendar (merged into this service; same database and same outbox) ----
# Calendar sharing (CC018). These URLs and tokens are for local mocks on ports 4101 and 4102.
# On Vercel, set the real receiver URLs and their own Bearer tokens as environment variables.
FMS_URL=http://127.0.0.1:4101/calendar
FMS_CALENDAR_TOKEN=change-me-dev-fms-calendar-token
SMS_URL=
# Local mock of SMS (npm run mocks): remove the two # below to use it. Left off so that, with SMS_SYNC_ENABLED=true,
# nothing is sent until the real SMS_URL and SMS_SERVICE_TOKEN are set.
# SMS_CALENDAR_TOKEN=change-me-dev-sms-calendar-token
# AUDIT_URL=http://127.0.0.1:4102/calendar
SYNC_RETRY_INTERVAL_SECONDS=60
SYNC_MAX_ATTEMPTS=20

# Used by the mocks (npm run mocks): where to send Audit's acknowledgment (this service), and the mock ports.
CCMS_CALENDAR_URL=http://127.0.0.1:3003
MOCK_FMS_PORT=4101
MOCK_AUDIT_PORT=4102

# ---- Calendar cal-1.0 (all optional; see docs/CAL-1.0.md) ----
# true = send `effect` and ONLINE entries to FMS. Default off.
CAL_EFFECT_ENABLED=false
# ---- SMS (Syllabus Management System, the SCMS code) ----
# SMS_SYNC_ENABLED=true turns the push on, but nothing is sent until BOTH SMS_URL and SMS_SERVICE_TOKEN are filled in.
# SMS_URL is SMS's address (a bare address gets /api/v1/calendar/sync added), e.g. https://their-address.example
# SMS_SERVICE_TOKEN is the key SMS issues to us (scopes write:calendar and read:terms); SMS_CALENDAR_TOKEN is the older name.
# Put the real URL and key in .env.local or your deployment secrets, never in git.
SMS_SYNC_ENABLED=true
SMS_SERVICE_TOKEN=
# true = read the academic terms from SMS (reader only; nothing is stored yet). Default off.
SMS_TERMS_ENABLED=false
# true = send the SMS queue every message, not only term snapshots. For a receiver that accepts anything (the mock).
SMS_SEND_ALL_MESSAGES=false
# HOLIDAY_AUTO_IMPORT=true makes the daily calendar-sync job add the national holidays of this year and the next (from Nager.Date)
# as ordinary campus-wide entries. Dates that already have an entry, including one the Super Admin deleted, are never added.
HOLIDAY_AUTO_IMPORT=false
# Dates a recurring entry is expanded for (default 2026-08-17 to 2026-12-12).
CAL_WINDOW_FROM=
CAL_WINDOW_TO=
