# ccms-identity-service — copy to .env.local.
# Run db:sync explicitly on a disposable local database before first use.
DATABASE_URL=postgres://ccms_identity:ccms_identity_dev_pw@127.0.0.1:15433/ccms_identity
DB_SYNCHRONIZE=false
# local | hosted. hosted refuses db:sync / schema synchronization and requires --confirm=<database> for migrations.
# Hosted deployments (Vercel, BE Dev 1's migration shell) must set DB_TARGET=hosted and DB_SYNCHRONIZE=false.
DB_TARGET=local

# Signing key for access tokens (RS256). Set a stable local key so tokens survive Identity restarts.
# Create one with:  npm run keygen   and paste the line it prints. Never commit it.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Token verification (Identity publishes the public keys)
IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
JWT_ISSUER=ccms-identity
JWT_AUDIENCE=ccms

# Service-to-service shared key and the Logs service (audit events)
SERVICE_KEY=change-me-dev-service-key
LOGS_SERVICE_URL=http://127.0.0.1:3002/api

# Server-to-server: Identity checks an account's office with the Core service.
CORE_SERVICE_URL=http://127.0.0.1:3003/api

# The address people use in the browser (the frontend). Used in the password reset link.
PUBLIC_BASE_URL=http://localhost:3000

# Job callers send this as "Authorization: Bearer <CRON_SECRET>" to /api/jobs/*. Without it the jobs never run.
CRON_SECRET=change-me-dev-cron-secret

# Email (password reset links). Pick ONE; with none set, the email is only printed in this server's console.
# Option A: SMTP, e.g. Gmail with an App Password (Google Account > Security > 2-Step Verification > App passwords)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   EMAIL_FROM="CCMS <yourname@gmail.com>"
# Option B: a generic HTTP mail API
#   EMAIL_API_URL=
#   EMAIL_API_KEY=

# Clerk sign-in (Landas 1; see docs/clerk-integration-analysis.md section 18). Off unless CLERK_AUTH_ENABLED=true.
# Identity verifies the Clerk session token with the instance's public key only: NO Clerk Secret Key is used or needed
# (Shared Clerk Access Playbook D1). A person gets CCMS access only after a Super Admin binds their Clerk user to a CCMS
# account; a matching email never grants access (playbook R3).
# CLERK_AUTH_ENABLED=false
# Frontend API URL of the Clerk instance (the "iss" claim), e.g. https://<instance>.clerk.accounts.dev for development.
# CLERK_ISSUER=
# JWKS Public Key (PEM) from the Clerk dashboard, on one line with \n escapes. During a key rotation, put both PEMs here.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Comma-separated browser origins allowed in the "azp" claim (the CCMS frontend), e.g. http://localhost:3000
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Session-token claim that carries the email (a hint for the Super Admin only). Default: email
# CLERK_EMAIL_CLAIM=email
# Tokens from dashboard impersonation ("act" claim) are refused unless this is true. Keep false in production.
# CLERK_ALLOW_IMPERSONATION=false

# First local administrator (explicit bootstrap:admin command only)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMPLOYEE_NO=ADMIN-001
BOOTSTRAP_ADMIN_NAME=System Administrator
