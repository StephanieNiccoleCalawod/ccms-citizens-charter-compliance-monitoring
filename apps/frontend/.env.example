# ccms-frontend — copy to .env.local.
# Where the API gateway runs. The frontend forwards every /api/* request there.
API_GATEWAY_URL=http://127.0.0.1:8080

# Insights (Sprint 5 Analytics) data source. The one switch:
#   true  = illustrative sample data (the page says so)
#   false = the analytics API (Sprint 6; not available yet)
#   unset = sample data in development, the API in production. The sample data is never a fallback when the API fails.
NEXT_PUBLIC_ANALYTICS_USE_MOCK_DATA=true

# Clerk sign-in (Landas 1). legacy (default) = email and password only, Clerk never loads | dual = both (Clerk sign-in at
# /login/clerk) | clerk = Clerk only. Clerk loads only with a publishable key (public by design; never a secret key here).
# NEXT_PUBLIC_AUTH_PROVIDER=legacy
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Never let the Clerk SDK create a temporary "keyless" Clerk app during development.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

# K16 disclosure line in the Insights About panel (all three YYYY-MM-DD, or no line is shown). Demo with seeded history only.
NEXT_PUBLIC_SEEDED_HISTORY_FROM=
NEXT_PUBLIC_SEEDED_HISTORY_TO=
NEXT_PUBLIC_GO_LIVE_DATE=
