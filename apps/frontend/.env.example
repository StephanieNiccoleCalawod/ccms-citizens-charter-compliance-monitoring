# ccms-frontend — copy to .env.local.
# Where the API gateway runs. The frontend forwards every /api/* request there.
API_GATEWAY_URL=http://127.0.0.1:8080

# Insights (Sprint 5 Analytics) data source. The one switch:
#   true  = illustrative sample data (the page says so)
#   false = the analytics API (Sprint 6; not available yet)
#   unset = sample data in development, the API in production. The sample data is never a fallback when the API fails.
NEXT_PUBLIC_ANALYTICS_USE_MOCK_DATA=true
