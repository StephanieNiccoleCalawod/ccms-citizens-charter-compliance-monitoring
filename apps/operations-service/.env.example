# ccms-operations-service (Transaction) — copy to .env.local.
# Run db:sync explicitly on a disposable local database before first use. Own database: ccms_operations, own credentials.
DATABASE_URL=postgres://ccms_operations:ccms_operations_dev_pw@127.0.0.1:5436/ccms_operations
DB_SYNCHRONIZE=false
# local | hosted. hosted refuses db:sync / schema synchronization and requires --confirm=<database> for migrations.
# Hosted deployments (Vercel, BE Dev 1's migration shell) must set DB_TARGET=hosted and DB_SYNCHRONIZE=false.
DB_TARGET=local

# Token verification (Identity publishes the public keys)
IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
# Identity (for the starter's position at Start, CC046). With or without the trailing /api. Empty = no position is copied.
IDENTITY_URL=http://127.0.0.1:3001
JWT_ISSUER=ccms-identity
JWT_AUDIENCE=ccms

# Service-to-service shared key and the Logs (Oversight) service: audit events and, since TT2, analytics events.
# With or without the trailing /api.
SERVICE_KEY=change-me-dev-service-key
LOGS_SERVICE_URL=http://127.0.0.1:3002/api

# Core (Catalogue + Calendar): standards, offices and the working-time engine. With or without the trailing /api.
CORE_URL=http://127.0.0.1:3003/api

# Job callers send this as "Authorization: Bearer <CRON_SECRET>" to /api/jobs/*. Without it the jobs never run.
CRON_SECRET=change-me-dev-cron-secret

# Receipt email (CC024, stretch). Leave SMTP_HOST empty to send nothing: receipts then stay PENDING/FAILED and are retried by the job.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@pup.edu.ph

