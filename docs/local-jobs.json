{
  "automaticScheduling": false,
  "description": "Local HTTP job endpoints are invoked manually with Authorization: Bearer <local CRON_SECRET>. The Identity, Core, and Operations vercel.json files schedule these endpoints on their respective Vercel projects. TT2 adds two unscheduled run-once jobs (historicalSchedule null): Operations /api/jobs/analytics-outbox and Oversight /api/jobs/analytics-backfill; scheduling them is a separate release decision.",
  "services": {
    "identity-service": {
      "port": 3001,
      "jobs": [
        {
          "path": "/api/jobs/outbox",
          "method": "GET",
          "historicalSchedule": "0 1 * * *"
        }
      ]
    },
    "core-service": {
      "port": 3003,
      "jobs": [
        {
          "path": "/api/jobs/outbox",
          "method": "GET",
          "historicalSchedule": "0 1 * * *"
        },
        {
          "path": "/api/jobs/calendar-sync",
          "method": "GET",
          "historicalSchedule": "5 1 * * *"
        }
      ]
    },
    "operations-service": {
      "port": 3004,
      "jobs": [
        {
          "path": "/api/jobs/outbox",
          "method": "GET",
          "historicalSchedule": "0 1 * * *"
        },
        {
          "path": "/api/jobs/compute-pending",
          "method": "GET",
          "historicalSchedule": "10 1 * * *"
        },
        {
          "path": "/api/jobs/auto-close",
          "method": "GET",
          "historicalSchedule": "20 1 * * *"
        },
        {
          "path": "/api/jobs/receipt-emails",
          "method": "GET",
          "historicalSchedule": "30 1 * * *"
        },
        {
          "path": "/api/jobs/acknowledgement-emails",
          "method": "GET",
          "historicalSchedule": "0 9 * * *"
        },
        {
          "path": "/api/jobs/acknowledgement-emails/retry",
          "method": "GET",
          "historicalSchedule": "0 17 * * *"
        },
        {
          "path": "/api/jobs/forecast",
          "method": "GET",
          "historicalSchedule": "0 18 * * *"
        },
        {
          "path": "/api/jobs/analytics-outbox",
          "method": "GET",
          "historicalSchedule": null
        }
      ]
    },
    "oversight-service": {
      "port": 3002,
      "jobs": [
        {
          "path": "/api/jobs/analytics-backfill",
          "method": "GET",
          "historicalSchedule": null
        }
      ]
    }
  }
}
